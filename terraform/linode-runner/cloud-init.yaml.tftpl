#cloud-config
package_update: true
packages:
  - ca-certificates
  - curl
  - gnupg
  - git
  - python3-venv
  - python3-pip
  - ansible
  - nginx
  - libnginx-mod-stream

# Self-destruct: the only cleanup mechanism other than an agent explicitly
# calling down.sh. No external reaper/cron -- the instance deletes itself by
# calling the Linode API on its own tag, ttl_seconds after boot. The token
# is scoped no differently than LINODE_TOKEN already is account-wide, so
# treat it like any other secret on this box: root-only (0600), and moot
# the moment the instance is gone.
write_files:
  - path: /etc/pmm-qa/linode-token
    permissions: "0600"
    owner: root:root
    content: |
      ${linode_token}
  - path: /usr/local/bin/pmm-qa-self-destruct.sh
    permissions: "0700"
    owner: root:root
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      token=$(cat /etc/pmm-qa/linode-token)
      id=$(curl -fsS -H "Authorization: Bearer $token" \
        -H 'X-Filter: {"tags": "pmm-qa-run:${run_id}"}' \
        "https://api.linode.com/v4/linode/instances" | python3 -c 'import json,sys; print(json.load(sys.stdin)["data"][0]["id"])')
      # Instance first, then its tag: the tag is the only handle on this box (no
      # terraform state), so set -e must abort before the tag delete if the
      # instance delete fails.
      curl -fsS -X DELETE -H "Authorization: Bearer $token" \
        "https://api.linode.com/v4/linode/instances/$id"
      curl -fsS -X DELETE -H "Authorization: Bearer $token" \
        "https://api.linode.com/v4/tags/pmm-qa-run:${run_id}" || true

  # Controllers behind a proxied-HTTPS-only network policy cannot open a
  # raw SSH connection to this box (confirmed live -- see docs.md). Every
  # command from up.sh/run.sh/sync.sh/extend.sh goes through this small
  # bearer-token-authenticated HTTPS service instead -- since the only port
  # that egress policy reliably carries real traffic on is 443, and PMM
  # Server also needs host 443 for its own UI, nginx's stream module
  # multiplexes both onto that one port by SNI (see the stream-router
  # write_files entry below): hostnames starting with "exec-" route here,
  # on a loopback-only port nginx forwards to; everything else routes to
  # PMM's own port. This exec-server itself never listens on a
  # controller-reachable port directly.
  - path: /etc/pmm-qa/exec-token
    permissions: "0600"
    owner: root:root
    content: |
      ${exec_token}
  # Generated by Terraform before this instance even boots, not here --
  # so run.sh can verify against a CA it already knows instead of trusting
  # blindly (see main.tf's tls_self_signed_cert.exec).
  - path: /etc/pmm-qa/exec-cert.pem
    permissions: "0644"
    owner: root:root
    content: |
      ${indent(6, exec_cert)}
  - path: /etc/pmm-qa/exec-key.pem
    permissions: "0600"
    owner: root:root
    content: |
      ${indent(6, exec_key)}
  - path: /opt/pmm-qa-exec-server.py
    permissions: "0755"
    owner: root:root
    content: |
      #!/usr/bin/env python3
      import http.server, ssl, json, subprocess, os

      TOKEN = open("/etc/pmm-qa/exec-token").read().strip()

      class ThreadingHTTPServer(http.server.ThreadingHTTPServer):
          daemon_threads = True

      class Handler(http.server.BaseHTTPRequestHandler):
          # Bounds how long one client's request line/headers can take to
          # arrive -- without this, one slow or half-open connection could
          # tie up a handler indefinitely. The command timeout above is
          # separate and covers the executed command itself, not the HTTP
          # read.
          timeout = 30

          def _unauthorized(self):
              self.send_response(401)
              self.end_headers()

          def do_GET(self):
              if self.path == "/health":
                  self.send_response(200)
                  self.send_header("Content-Type", "application/json")
                  self.end_headers()
                  self.wfile.write(b'{"status":"ok"}')
              else:
                  self.send_response(404)
                  self.end_headers()

          def do_POST(self):
              if self.path != "/exec":
                  self.send_response(404); self.end_headers(); return
              if self.headers.get("Authorization", "") != f"Bearer {TOKEN}":
                  self._unauthorized(); return
              length = int(self.headers.get("Content-Length", 0))
              body = json.loads(self.rfile.read(length) or b"{}")
              cmd = body.get("cmd", "")
              timeout = body.get("timeout", 600)
              try:
                  proc = subprocess.run(["bash", "-c", cmd], capture_output=True, text=True, timeout=timeout)
                  resp = {"stdout": proc.stdout, "stderr": proc.stderr, "exit_code": proc.returncode}
              except subprocess.TimeoutExpired as e:
                  resp = {"stdout": e.stdout or "", "stderr": (e.stderr or "") + "\n[exec-server] command timed out", "exit_code": 124}
              data = json.dumps(resp).encode()
              self.send_response(200)
              self.send_header("Content-Type", "application/json")
              self.send_header("Content-Length", str(len(data)))
              self.end_headers()
              self.wfile.write(data)

          def log_message(self, fmt, *args):
              pass

      httpd = ThreadingHTTPServer(("127.0.0.1", 8843), Handler)
      ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
      ctx.load_cert_chain("/etc/pmm-qa/exec-cert.pem", "/etc/pmm-qa/exec-key.pem")
      httpd.socket = ctx.wrap_socket(httpd.socket, server_side=True)
      httpd.serve_forever()
  - path: /etc/nginx/stream-enabled/pmm-qa-sni-router.conf
    permissions: "0644"
    owner: root:root
    content: |
      # Routes by SNI, without terminating TLS (ssl_preread only reads the
      # ClientHello, doesn't decrypt) -- both the exec-server and PMM Server
      # keep handling their own TLS exactly as if this weren't here.
      stream {
        map $ssl_preread_server_name $pmm_qa_backend {
          ~^exec-  127.0.0.1:8843;
          default  127.0.0.1:8443;
        }
        server {
          listen 443;
          ssl_preread on;
          proxy_pass $pmm_qa_backend;
        }
      }
  - path: /etc/systemd/system/pmm-qa-exec.service
    permissions: "0644"
    owner: root:root
    content: |
      [Unit]
      Description=pmm-qa HTTPS exec server (SSH replacement for proxied-HTTPS-only controllers)
      After=network.target

      [Service]
      ExecStart=/usr/bin/python3 /opt/pmm-qa-exec-server.py
      Restart=on-failure
      RestartSec=2

      [Install]
      WantedBy=multi-user.target

runcmd:
  - systemctl daemon-reload
  - systemctl enable --now pmm-qa-exec
  # Ubuntu's nginx.conf only wires up conf.d/sites-enabled inside the http{}
  # block -- stream{} is a top-level directive, so it needs its own include
  # line added directly, not dropped into an existing include dir.
  - mkdir -p /etc/nginx/stream-enabled
  - sed -i '/^events {/i include /etc/nginx/stream-enabled/*.conf;' /etc/nginx/nginx.conf
  - rm -f /etc/nginx/sites-enabled/default
  - nginx -t
  - systemctl enable --now nginx
  - systemctl restart nginx
  - install -m 0755 -d /etc/apt/keyrings
  - curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  - chmod a+r /etc/apt/keyrings/docker.asc
  - >-
    echo "deb [arch=$(dpkg --print-architecture)
    signed-by=/etc/apt/keyrings/docker.asc]
    https://download.docker.com/linux/ubuntu
    $(. /etc/os-release && echo $VERSION_CODENAME) stable"
    > /etc/apt/sources.list.d/docker.list
  - apt-get update -y
  - apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  - systemctl enable --now docker
  - ansible-galaxy collection install community.docker
  - systemd-run --on-active=${ttl_seconds} --unit=pmm-qa-self-destruct /usr/local/bin/pmm-qa-self-destruct.sh
  # Marker up.sh polls for (via a /exec command, once the exec-server itself
  # answers /health) before cloning/running anything -- the exec-server
  # comes up first so it's reachable, but "ready" means docker+ansible are
  # actually installed, not just that the transport is up.
  - touch /var/lib/cloud/pmm-qa-cloud-init-done
