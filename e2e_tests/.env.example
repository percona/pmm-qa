# Copy to .env for local Playwright runs. Staging values are common for manual QA.
# Migration runs use .claude/scripts/chaos-pmm.sh test, which runs on the CHAOS VM with
# PMM_UI_URL=https://127.0.0.1/, the VM's per-run ADMIN_PASSWORD, and PMM_MIGRATION=1.
PMM_UI_URL=http://127.0.0.1/
ADMIN_PASSWORD=admin
WORKERS=1
