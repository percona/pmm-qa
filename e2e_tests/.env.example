# Copy to .env for local Playwright runs. Staging values are common for manual QA.
# Migration runs use run-migration-single-test.sh, which exports the local provisioner's
# PMM_UI_URL=https://127.0.0.1/, ADMIN_PASSWORD=admin, and PMM_MIGRATION=1.
PMM_UI_URL=http://127.0.0.1/
ADMIN_PASSWORD=admin
WORKERS=1
