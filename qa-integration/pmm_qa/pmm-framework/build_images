#!/usr/bin/env bash
#
# build_images -- prebake database images ahead of a run.
#
#   ./build_images ps=8.4 mysql=8.0 pxc-proxysql=8.0
#
# pmm-framework builds a missing image on demand; this exists to warm a cache.

set -euo pipefail

FRAMEWORK_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
QA_INTEGRATION_ROOT=$(cd "$FRAMEWORK_DIR/../.." && pwd)

# shellcheck source=lib/common.sh
source "$FRAMEWORK_DIR/lib/common.sh"
# shellcheck source=lib/config.sh
source "$FRAMEWORK_DIR/lib/config.sh"
# shellcheck source=lib/images.sh
source "$FRAMEWORK_DIR/lib/images.sh"

if [[ ${1:-} == --tags ]]; then
  image_tags "${2:?Usage: build_images --tags ENGINE}"
  exit
fi
(($# > 0)) || die "Usage: build_images ENGINE=VERSION... | --tags ENGINE"
for spec in "$@"; do
  engine=${spec%%=*}
  engine=${engine,,}
  [[ $spec == *=* ]] || die "'$spec' needs a version, e.g. $engine=8.4."
  declare -F "build_${engine//-/_}_image" >/dev/null || die "No prebaked image for '$engine'."
  "build_${engine//-/_}_image" "${spec#*=}"
done
