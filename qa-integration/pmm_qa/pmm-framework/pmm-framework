#!/usr/bin/env bash
#
# pmm-framework -- provision databases and register them with a PMM Server.
#
#   ./pmm-framework --database ps=8.4 --database psmdb,SETUP_TYPE=sharding
#   ./pmm-framework --parallel --pmm-server-ip 10.0.0.5 --database valkey=8
#   ./pmm-framework --help
#
# This entrypoint is intentionally thin: it checks the Bash version, works out
# where the repo lives, sources every module, then hands over to parse_args()
# and run_database_setups(). All real behaviour lives in lib/ and images/.
#
# Layout:
#   lib/common.sh     logging, die(), small value helpers
#   lib/config.sh     the database catalogue, value resolution, version helpers
#   lib/cli.sh        argument parsing and the --database spec grammar
#   lib/docker.sh     finding the PMM Server
#   lib/images.sh     building prebaked database images
#   lib/prebaked.sh   the docker backend: PMM Client install, agent, retries
#   images/*/        per database: its Dockerfile, setup.sh and data files
#   lib/dispatch.sh   the map from a database type to its setup function
#   lib/execution.sh  preflight and the sequential/parallel strategies
#
# See ARCHITECTURE.md for the call flow, a diagram, and how to add a database.

set -euo pipefail

# Bash 5.1 is the floor: run_parallel_setups waits with `wait -n -p`.
if ((BASH_VERSINFO[0] < 5 || (BASH_VERSINFO[0] == 5 && BASH_VERSINFO[1] < 1))); then
  printf 'ERROR: pmm-framework requires Bash 5.1 or newer (found %s).\n' \
    "$BASH_VERSION" >&2
  exit 1
fi

# Let command substitutions inherit `set -e`, so a failing $(...) aborts the
# run instead of silently yielding an empty value.
shopt -s inherit_errexit

# Anchor every path to this script rather than the caller's cwd, so the
# framework can be invoked from anywhere:
#   FRAMEWORK_DIR       .../qa-integration/pmm_qa/pmm-framework
#   PMM_QA_ROOT         .../qa-integration/pmm_qa
#   QA_INTEGRATION_ROOT .../qa-integration
FRAMEWORK_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PMM_QA_ROOT=$(cd "$FRAMEWORK_DIR/.." && pwd)
QA_INTEGRATION_ROOT=$(cd "$PMM_QA_ROOT/.." && pwd)
export FRAMEWORK_DIR PMM_QA_ROOT QA_INTEGRATION_ROOT

# shellcheck source=lib/common.sh
source "$FRAMEWORK_DIR/lib/common.sh"
# shellcheck source=lib/config.sh
source "$FRAMEWORK_DIR/lib/config.sh"
# shellcheck source=lib/cli.sh
source "$FRAMEWORK_DIR/lib/cli.sh"
# shellcheck source=lib/docker.sh
source "$FRAMEWORK_DIR/lib/docker.sh"
# shellcheck source=lib/images.sh
source "$FRAMEWORK_DIR/lib/images.sh"
# shellcheck source=lib/prebaked.sh
source "$FRAMEWORK_DIR/lib/prebaked.sh"
# shellcheck source=images/mysql/setup.sh
source "$FRAMEWORK_DIR/images/mysql/setup.sh"
# shellcheck source=images/pxc/setup.sh
source "$FRAMEWORK_DIR/images/pxc/setup.sh"
# shellcheck source=images/pdpgsql/setup.sh
source "$FRAMEWORK_DIR/images/pdpgsql/setup.sh"
# shellcheck source=images/pgsql/setup.sh
source "$FRAMEWORK_DIR/images/pgsql/setup.sh"
# shellcheck source=images/psmdb/setup.sh
source "$FRAMEWORK_DIR/images/psmdb/setup.sh"
# shellcheck source=images/haproxy/setup.sh
source "$FRAMEWORK_DIR/images/haproxy/setup.sh"
# shellcheck source=images/external/setup.sh
source "$FRAMEWORK_DIR/images/external/setup.sh"
# shellcheck source=images/valkey/setup.sh
source "$FRAMEWORK_DIR/images/valkey/setup.sh"
# shellcheck source=lib/dispatch.sh
source "$FRAMEWORK_DIR/lib/dispatch.sh"
# shellcheck source=lib/execution.sh
source "$FRAMEWORK_DIR/lib/execution.sh"

parse_args "$@"

# Checked up front so a missing tool fails in milliseconds. curl is not here:
# only the PSMDB setups need it, so preflight checks for it conditionally.
require_command docker
require_command bash

run_database_setups
