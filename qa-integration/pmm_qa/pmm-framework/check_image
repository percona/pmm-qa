#!/usr/bin/env bash
#
# check_image -- start a prebaked image and check it works, as the build
# workflow does before publishing one.
#
#   ./check_image pdpgsql=17

set -euo pipefail

[[ $# -eq 1 && $1 == *=* ]] || { echo 'Usage: check_image ENGINE=VERSION' >&2; exit 2; }
engine=${1%%=*}
version=${1#*=}
image=pmm-qa/$engine:$version

trap 'docker rm -fv probe >/dev/null 2>&1 || true' EXIT

# Start the image as setups do, unprivileged under systemd, and fail on any failed unit.
boot() {
  local state='' i
  docker run -d --name probe --cgroupns=host -v /sys/fs/cgroup:/sys/fs/cgroup:rw --tmpfs /run --tmpfs /run/lock "$@" "$image"
  # Until systemd is up, systemctl prints no state, or offline.
  for i in $(seq 1 30); do
    state=$(docker exec probe systemctl is-system-running --wait 2>/dev/null) && break
    [ -z "$state" ] || [ "$state" = offline ] || break
    sleep 1
  done
  if [ "$state" != running ]; then
    docker exec probe systemctl --failed --no-pager
    exit 1
  fi
}

case $engine in
  pdpgsql)
    # systemd starts PostgreSQL with pg_stat_monitor preloaded.
    boot
    for i in $(seq 1 60); do
      docker exec -u postgres probe pg_isready -q 2>/dev/null && break
      if [ "$i" -eq 60 ]; then
        docker exec probe tail -30 "/var/log/postgresql/postgresql-$version-main.log"
        exit 1
      fi
      sleep 1
    done
    docker exec -u postgres probe psql -v ON_ERROR_STOP=1 -c 'CREATE EXTENSION pg_stat_monitor' -c 'SELECT pg_stat_monitor_version()'
    docker exec -u postgres probe psql -tAc 'SHOW server_encoding' | grep -qx UTF8
    docker exec probe sh -c 'patroni --version && etcd --version && pgbackrest version'
    ;;
  ssl-pdpgsql)
    # The image ships no certificates; make a set as setup_ssl_pdpgsql does.
    boot
    docker exec probe sh -ceu "cd /artifacts && bash create_certs.sh >/dev/null 2>&1
      cp -a certificates/. /var/lib/pgsql/$version/data/
      chown -R postgres:postgres /var/lib/pgsql/$version/data
      chmod -R 0700 /var/lib/pgsql/$version/data
      service postgresql start"
    docker exec -e PGPASSWORD=pmm probe psql -v ON_ERROR_STOP=1 'host=127.0.0.1 user=pmm dbname=postgres sslmode=require' \
      -c 'SELECT ssl FROM pg_stat_ssl WHERE pid = pg_backend_pid()' -c 'SELECT count(*) FROM pg_stat_statements'
    ;;
  pgsql)
    boot
    docker exec -u postgres probe psql -v ON_ERROR_STOP=1 -c 'SELECT count(*) FROM pg_stat_statements'
    docker exec -u postgres probe psql -tAc 'SHOW server_encoding' | grep -qx UTF8
    ;;
  valkey)
    boot
    docker exec probe sh -c 'valkey-server --version && valkey-cli --version'
    ;;
  external)
    boot --privileged
    docker exec probe sh -c 'redis_exporter --version && process-exporter --version'
    ;;
  haproxy)
    boot --privileged
    docker exec probe haproxy -vv | grep prometheus-exporter
    ;;
  kerberos)
    docker run --rm --entrypoint sh "$image" -c 'command -v krb5kdc && command -v kadmin.local && command -v kdb5_util'
    ;;
  psmdb)
    # mongod needs the mongod.conf compose mounts, so check the tools run.
    docker run --rm "$image" sh -c 'mongod --version && mongos --version && pbm version && command -v mgodatagen'
    ;;
  pxc-proxysql)
    # The full cluster: three nodes synced and ProxySQL seeing all of them.
    boot
    docker exec --user root probe pmm_pxc start
    docker exec probe sysbench --version
    ;;
  mysql)
    if [ "$version" != 5.7 ]; then
      boot
      docker exec probe sh -ceu 'mysqld --initialize-insecure --user=mysql; systemctl start mysqld'
      docker exec probe mysql -uroot -e "ALTER USER root@localhost IDENTIFIED BY 'probe'"
    else
      docker run -d --name probe -e MYSQL_ROOT_PASSWORD=probe "$image"
    fi
    for i in $(seq 1 90); do
      if docker exec -e MYSQL_PWD=probe probe mysql -uroot -h127.0.0.1 -e 'SELECT VERSION()'; then
        break
      fi
      if [ "$i" -eq 90 ]; then
        docker logs probe
        exit 1
      fi
      sleep 1
    done
    docker exec probe sysbench --version
    ;;
  ps)
    boot
    docker exec probe sh -ceu 'mysqld --initialize-insecure --user=mysql; systemctl start mysqld'
    docker exec probe mysql -uroot -e 'SELECT VERSION()'
    docker exec probe sh -c 'sysbench --version && xtrabackup --version && ps-admin --help >/dev/null'
    ;;
  *)
    echo "No check for '$engine'." >&2
    exit 2
    ;;
esac
